-- en este archivo se añade la vista heredada del formulario de oportunidad (crm.lead) para añadir los campos técnicos del proyecto a la oportunidad en Odoo.
-- especificamente, se añade un nuevo grupo llamado "Datos del Proyecto" que contiene los campos project_type, project_odoo_version, project_technical_id, project_user_count y project_hours.

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="crm_lead_form_view_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//group" position="after">
                <group string="Datos del Proyecto">
                    <group>
                        <field name="project_type"/>
                        <field name="project_odoo_version"/>    
                        <field name="project_technical_id"/>
                    </group>
                    <group>
                        <field name="project_user_count"/>
                        <field name="project_hours"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

