-- custom_addons/crm_project_custom/views/sale_order_views.xml
-- este archivo contiene la vista heredada del formulario de cotización (sale.order) para añadir los campos técnicos del proyecto a la cotización en Odoo.
-- especificamente, se añade una nueva pestaña llamada "Datos del Proyecto" que contiene los campos project_type, project_odoo_version, project_technical_id, project_user_count y project_hours.

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_form_view_inherit_project" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.project</field>
        <field name="model">sale.order</field>
        
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//notebook" position="inside">
                <page string="Datos del Proyecto" name="project_data">
                    <group>
                        <group>
                            <field name="project_type"/>
                            <field name="project_odoo_version"/>
                            <field name="project_technical_id"/>
                        </group>
                        <group>
                            <field name="project_user_count"/>
                            <field name="project_hours"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>