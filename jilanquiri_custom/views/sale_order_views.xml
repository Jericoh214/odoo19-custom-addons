<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sale_order_jilanquiri_form" model="ir.ui.view">
            <field name="name">sale.order.jilanquiri.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                
                <!-- 1. Pestaña de Condiciones Jilanquiri -->
                <xpath expr="//notebook" position="inside">
                    <page name="jilanquiri_page" string="Condiciones Jilanquiri">
                        <group name="jilanquiri_group">
                            <group name="jilanquiri_group_comercial" string="Condiciones Comerciales">
                                <field name="x_plazo_entrega"/>
                                <field name="x_disponibilidad_stock"/>
                                <field name="x_marca_sugerida"/>
                            </group>
                            <group name="jilanquiri_group_banco" string="Cuentas Bancarias (Reporte)">
                                <!-- Campos que permiten cambiar la información de cuenta si es necesario -->
                                <field name="x_nro_cuenta_cte"/>
                                <field name="x_nro_cci"/>
                            </group>
                        </group>
                    </page>
                </xpath>

                <!-- 2. Columna Marca en la tabla de productos (Sintaxis <list> para Odoo 19) -->
                <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                    <field name="x_marca" string="Marca" optional="show"/>
                </xpath>

                <!-- 3. Placeholder descriptivo en la caja de Términos y Condiciones -->
                <xpath expr="//field[@name='note']" position="attributes">
                    <attribute name="placeholder">Términos y condiciones... (Separador de filas -> |||)</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
