<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_jilanquiri" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.jilanquiri</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <!-- 1. Ocultamos el campo nativo de Términos de pago para evitar redundancia -->
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 2. Posicionamos tus campos personalizados debajo de la Lista de precios -->
            <xpath expr="//field[@name='pricelist_id']" position="after">
                <field name="condicion_pago_requerida"/>
                <field name="tiempo_entrega_dias"/>
                <field name="requiere_certificado_calidad"/>
                <field name="contacto_tecnico"/>
            </xpath>

        </field>
    </record>
</odoo>